<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests use RefreshDatabase: never point this at the live "simutu" database. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="simutu_testing" force="true"/>
        <!-- Never call the real HRIS API from tests; HRIS tests fake it with Http::fake(). -->
        <env name="HRIS_API_URL" value="" force="true"/>
        <env name="HRIS_API_USERNAME" value="" force="true"/>
        <env name="HRIS_API_PASSWORD" value="" force="true"/>
        <env name="JOTFORM_API_KEY" value="" force="true"/>
        <env name="DOKTER_API_URL" value="" force="true"/>
        <env name="DOKTER_API_USERNAME" value="" force="true"/>
        <env name="DOKTER_API_PASSWORD" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
